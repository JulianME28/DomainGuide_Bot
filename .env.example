# ============================================================================
# ШАБЛОН НАЛАШТУВАНЬ.
#
# Цей файл — приклад, він потрапляє в git і секретів не містить.
# Робочий файл називається .env — саме він читається ботом і саме він
# захований у .gitignore.
#
# Якщо .env загубився: скопіювати цей файл у .env і заповнити значення.
#   Windows PowerShell:  Copy-Item .env.example .env
# ============================================================================


# --- Telegram ---------------------------------------------------------------

# Токен бота. Отримати: написати @BotFather в Telegram → /newbot → скопіювати
# рядок виду 1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Без цього значення бот не запуститься.
BOT_TOKEN=


# --- Джерело даних ----------------------------------------------------------

# Звідки бот бере дані. Поки підтримується лише sheets (Google Таблиці).
DATA_BACKEND=sheets

# ID таблиці — довгий шматок з посилання на неї:
# https://docs.google.com/spreadsheets/d/ЦЕЙ_ШМАТОК_І_Є_ID/edit
GOOGLE_SPREADSHEET_ID=

# Шлях до файлу-ключа сервіс-акаунта Google (той самий credentials.json).
# Шлях відносно кореня проєкту. Файл у .gitignore — у git не потрапляє.
# Не забути: у самій таблиці треба натиснути «Поділитися» і дати доступ
# «Переглядач» на пошту сервіс-акаунта (вона всередині credentials.json,
# поле client_email).
GOOGLE_CREDENTIALS_FILE=credentials.json


# --- Доступ (безпека) -------------------------------------------------------

# Кому дозволено користуватися ботом. Telegram ID через кому, без пробілів:
# ALLOWED_USER_IDS=850410806,123456789
# Свій ID можна дізнатися у бота @userinfobot.
# Порожній список = бот не відповідає нікому.
ALLOWED_USER_IDS=

# Кому доступне адмін-меню: статус баз, карта колонок, оновлення кешу,
# лог останніх запитів. Теж через кому.
ADMIN_USER_IDS=


# --- Доступ за КОДОМ (необовʼязково) ----------------------------------------
#
# Щоб нова людина могла зайти САМА — ввівши код, який ви їй дали, — замість
# ручного дописування її ID у ALLOWED_USER_IDS. Бот лишається закритим: без
# коду не зайти. Хто ввів правильний код — додається НАЗАВЖДИ у файл
# data/allowed_users.json (він не в git; переживає перезапуск і git pull).
#
# Порожнє ACCESS_CODE = функція ВИМКНЕНА (працює лише список ID вище, як було).
# Порівняння коду: пробіли по краях обрізаються, РЕГІСТР значущий
# («Team2026» ≠ «team2026»). Змінити код = виправити цей рядок і перезапустити
# бота (уже впущені за старим кодом лишаються — код діє лише на нових).
#
# ⚠️ Файл .env і код живуть на СПІЛЬНОМУ сервері — код доступу варто час від
#    часу МІНЯТИ (і одразу після того, як хтось зайвий міг його дізнатися).
#    Побачити, хто зайшов за кодом, і прибрати когось — у адмін-меню
#    «Дозволені користувачі» або командою /revoke <id>.
ACCESS_CODE=

# Антибрутфорс: не більше ACCESS_CODE_ATTEMPTS невдалих спроб коду за
# ACCESS_CODE_WINDOW_SECONDS секунд на одного користувача. Дефолти 5 / 3600.
ACCESS_CODE_ATTEMPTS=5
ACCESS_CODE_WINDOW_SECONDS=3600

# Де зберігати тих, хто зайшов за кодом. Дефолт data/allowed_users.json
# (відносно кореня проєкту). Файл .json уже в .gitignore — у git не потрапляє.
ACCESS_STORE_FILE=data/allowed_users.json


# --- Нейромережа (ШІ) для РОЗМИТИХ вільних запитів --------------------------
#
# ШІ — це РЕЗЕРВ. Усе, що бот уміє зараз (кнопки, чіткі текстові запити),
# лишається миттєвим і безкоштовним. ШІ вмикається ЛИШЕ коли власний словник
# не зрозумів запит (наприклад: «підбери щось пристойне під Німеччину, тільки
# не сміття»). ШІ бачить тільки текст запиту й перелік доступних фільтрів,
# країн і мов — донорів, доменів чи вмісту бази він не бачить НІКОЛИ.
#
# none      = ШІ вимкнено повністю (поточний режим). Впишете ключ — і все.
# anthropic = увімкнути ШІ через Anthropic (Claude).
# openai    = увімкнути ШІ через OpenAI (GPT).
# Перемикання лише тут, у .env — код міняти не треба.
LLM_PROVIDER=none

# Ключ доступу до ШІ. Порожній = ШІ вимкнено, навіть якщо провайдера вказано.
# Ключ, як і токен бота, у git не потрапляє й у лог не пишеться.
#
# Для anthropic: console.anthropic.com → Settings → API Keys → Create Key.
#   формат ключа: sk-ant-…
# Для openai:    platform.openai.com → API keys → Create new secret key.
#   формат ключа: sk-… або sk-proj-… (ключі проєкту)
LLM_API_KEY=

# Модель. Лишіть ПОРОЖНІМ — візьметься дешевий дефолт відповідного провайдера
#   (anthropic → claude-haiku-4-5-20251001; openai → gpt-4o-mini).
# Або впишіть іншу актуальну модель провайдера (напр. для openai — новіший
# дешевий mini/nano; звіряйте назву в документації провайдера).
LLM_MODEL=

# Модель РОЗМОВНОЇ смуги — консультанта по SEO/лінкбілдингу (пояснює, радить,
# веде діалог). Порожнє = та сама, що LLM_MODEL. Для якісної розмови варто
# поставити сильнішу — вона бачить лише текст, не дані:
#   РЕКОМЕНДОВАНО як старт:  LLM_CHAT_MODEL=gpt-4.1-mini   (дешева, якісна)
#   якщо схочеться кращої розмови:  LLM_CHAT_MODEL=gpt-4o
# Фільтри при цьому лишаються на дешевій LLM_MODEL (двоярусність без коду).
LLM_CHAT_MODEL=

# Скільки секунд чекати відповіді ШІ, перш ніж здатися й показати підказку.
LLM_TIMEOUT_SECONDS=20

# Ліміт токенів на відповідь ШІ. Потрібен запас: reasoning-моделі витрачають
# частину ліміту на «міркування», і замалий ліміт обриває JSON (у логах —
# «обрізана на ліміті токенів»). Дефолт 800; для reasoning-моделей можна більше.
LLM_MAX_TOKENS=800

# Ліміт токенів РОЗМОВНОЇ смуги (консультант відповідає довше за фільтр-JSON).
# Помірний навмисно: довші відповіді + сильніша модель = дорожчі виклики. Дефолт 1200.
LLM_CHAT_MAX_TOKENS=1200

# Контроль витрат: не більше LLM_CALLS_LIMIT викликів ШІ від одного користувача
# за LLM_WINDOW_SECONDS секунд (окремо від загального ліміту запитів вище).
LLM_CALLS_LIMIT=10
LLM_WINDOW_SECONDS=3600


# --- Продуктивність ---------------------------------------------------------

# Скільки хвилин дані живуть у пам'яті, перш ніж бот перечитає таблицю.
# Більше значення = швидші відповіді, але дані оновлюються рідше.
# Адмін може оновити дані будь-коли кнопкою «Оновити дані».
CACHE_TTL_MINUTES=30

# Ліміт запитів на одного користувача, щоб бот не перевантажували.
# Приклад нижче: не більше 20 запитів за 60 секунд.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60


# --- Логування --------------------------------------------------------------

# Скільки подробиць писати в лог: DEBUG (усе) / INFO (звичайний) /
# WARNING (тільки проблеми) / ERROR (тільки помилки).
# Домени донорів у лог не пишуться НІКОЛИ, за жодного рівня.
LOG_LEVEL=INFO
